# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=frontier
POSTGRES_USER=frontier
POSTGRES_PASSWORD=your_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Docker Compose (сервер) ───────────────────────────────────────────────────
# Профили для `docker compose build` без ручного --profile (см. docs/ops-server-troubleshooting.md)
# COMPOSE_PROFILES=core,ingest,worker,crawl,paddleocr,mcp,admin

# ── GigaChat / gpt2giga-proxy ─────────────────────────────────────────────────
GIGACHAT_CREDENTIALS=your_gigachat_credentials_here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Базовый URL API (как в telegram-assistant / gpt2giga)
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
# False — отключить проверку TLS (типично за корпоративным прокси/MITM). True — прод с доверенным CA в образе
GIGACHAT_VERIFY_SSL_CERTS=False
GPT2GIGA_LOG_LEVEL=INFO
# Deployment overlay label; see docs/runtime-modes.md.
# FRONTIER_RUNTIME_MODE=custom
# Модели чата (линейка GigaChat 2 Lite / Pro / Max): https://developers.sber.ru/docs/ru/gigachat/models/updates
# Релевантность по умолчанию вызывает Pro (GIGACHAT_MODEL_PRO), если GIGACHAT_MODEL_RELEVANCE не задан.
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_MODEL_LITE=GigaChat-2
GIGACHAT_MODEL_PRO=GigaChat-2-Pro
GIGACHAT_MODEL_MAX=GigaChat-2-Max
# Wormsoft text routing defaults used by admin LLM routing when no DB override exists.
# WORMSOFT_API_BASE=https://ai.wormsoft.ru/api/gpt
# WORMSOFT_API_KEY=
# WORMSOFT_MODEL_DEFAULT=wormsoft/agent/medium
# Balanced routing defaults
# GIGACHAT_MODEL_RELEVANCE=GigaChat-2
# GIGACHAT_MODEL_CONCEPTS=GigaChat-2
# GIGACHAT_MODEL_VALENCE=GigaChat-2
# GIGACHAT_MODEL_MCP_SYNTHESIS=GigaChat-2
# GIGACHAT_VISION_MODEL=GigaChat-2-Pro
# GIGACHAT_SESSION_CACHE_ENABLED=true
# GIGACHAT_ESCALATION_ENABLED=true
# GIGACHAT_TOKEN_BUDGET_RELEVANCE=1500
# GIGACHAT_TOKEN_BUDGET_CONCEPTS=1500
# GIGACHAT_TOKEN_BUDGET_RELEVANCE_CONCEPTS=1800
# GIGACHAT_TOKEN_BUDGET_VALENCE=1200
# GIGACHAT_TOKEN_BUDGET_EMBED=1200
# Embeddings:
# - Embeddings = 1024d, 512 tokens
# - EmbeddingsGigaR = 2560d, 4096 tokens
# - GigaEmbeddings-3B-2025-09 = 2048d, 4096 tokens
# Production default today:
# GIGACHAT_EMBEDDINGS_MODEL=EmbeddingsGigaR
# EMBED_DIM=2560
# If you switch embedding model, update EMBED_DIM before rebuild/reindex.
# Safe zero-downtime embedding migration:
# - keep base names as stable logical indexes
# - point aliases at the active versioned collections
# - swap aliases only after backfill/reindex
# QDRANT_COLLECTION=frontier_docs
# QDRANT_COLLECTION_ALIAS=frontier_docs_active
# QDRANT_TRENDS_COLLECTION=trend_clusters
# QDRANT_TRENDS_COLLECTION_ALIAS=trend_clusters_active
# QDRANT_FILTER_EMBEDDING_VERSION=true
# QDRANT_ENFORCE_COLLECTION_SCHEMA=true
# GIGACHAT_TOKEN_BUDGET_VISION_PROMPT=600
# GIGACHAT_RELEVANCE_GRAY_ZONE=0.1
# GIGACHAT_RC_JOINT_ENABLED=false
# GIGACHAT_RC_JOINT_WORKSPACES=
# GIGACHAT_RC_JOINT_SOURCES=
# GIGACHAT_BALANCE_ALERT_THRESHOLD=100000
# GIGACHAT_MAX_SIMULTANEOUS_REQUESTS=1
# GIGACHAT_MIN_REQUEST_INTERVAL_MS=250
# GPT2GIGA_ENABLE_IMAGES=True
# Опционально: GigaChat-2-Max только для ручечных quality-экспериментов, не как production default
# GIGACHAT_MODEL_RELEVANCE=GigaChat-2-Max
# Vision (картинки): production-safe default = GigaChat-2-Pro; Max нужен только как fallback/escalation
# GIGACHAT_VISION_MODEL=GigaChat-2-Pro

# PaddleOCR (опционально): docker compose --profile core --profile paddleocr up -d paddleocr
# В worker: PADDLEOCR_URL=http://paddleocr:8008
# PADDLEOCR_URL=
# PADDLEOCR_PORT=8008
# true — прогрузка при старте + /readyz/healthcheck healthy после загрузки (рекомендуется в проде)
# false — lazy при первом OCR; до первого запроса /readyz=503, healthcheck ждёт start_period
# LOCAL_OCR_PRELOAD=true
# Сборка paddleocr на сервере: зеркало PyPI (успешно при таймаутах pypi.org)
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# Офлайн-веса (volume paddleocr_models → /root/.paddleocr в контейнере): скопируй каталоги после успешной загрузки
# на машине с доступом к BCE, либо укажи абсолютные пути внутри контейнера:
# LOCAL_OCR_DET_MODEL_DIR=/root/.paddleocr/whl/det/ch/ch_PP-OCRv4_det_infer
# LOCAL_OCR_REC_MODEL_DIR=/root/.paddleocr/whl/rec/cyrillic/cyrillic_PP-OCRv4_rec_infer
# LOCAL_OCR_CLS_MODEL_DIR=/root/.paddleocr/whl/cls/ch_ppocr_mobile_v2.0_cls_infer

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_PASSWORD=your_neo4j_password_here

# ── S3 / Cloud.ru ─────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=https://s3.cloud.ru
S3_BUCKET_NAME=your_bucket_name_here
S3_ACCESS_KEY_ID=your_s3_access_key_id_here
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key_here
S3_REGION=ru-central-1
# При переносе со старого .env проверь, что каждая переменная на отдельной строке (без склейки с DB_URL и т.п.)

# ── Worker tuning (shared/config.py — все поля с дефолтами) ──────────────────
# Группа консьюмеров Redis Stream, батч, ретраи, backoff:
# INDEXING_CONSUMER_GROUP=enrichment_workers
# INDEXING_BATCH_SIZE=32
# INDEXING_MAX_RETRIES=5
# INDEXING_BACKOFF_MS=2000
# Порог релевантности для фильтра постов (0.0–1.0):
# DEFAULT_RELEVANCE_THRESHOLD=0.6
# Idle-claim: забрать сообщение у упавшего консьюмера через N мс (дефолт 10 мин):
# INDEXING_CLAIM_IDLE_MS=600000
# Global kill switch for image/video analysis to save tokens.
# When false, worker will not start VisionTask and media posts will be marked as skipped.
# VISION_ENABLED=true
# VISION_CLAIM_IDLE_MS=600000
# VISION_MAX_DELIVERY_COUNT=5
# VISION_DLQ_STREAM=stream:posts:vision:dlq
# REDIS_STREAM_LAG_ALERT_THRESHOLD=1000
# REDIS_STREAM_PENDING_ALERT_THRESHOLD=100
# REDIS_STREAM_OLDEST_PENDING_AGE_ALERT_SECONDS=900
# Очистка мёртвых консьюмеров каждые N секунд (дефолт 30 мин):
# INDEXING_CONSUMER_CLEANUP_INTERVAL=1800

# ── Admin alerting ──────────────────────────────────────────────────────────
# Optional: direct low-balance alerts to Telegram bot.
# TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=@your_alert_channel
# TELEGRAM_ALERT_PROXY_URL=socks5://xray:10808
# ADMIN_GIGACHAT_BALANCE_REFRESH_CRON=*/1 * * * *
# ADMIN_WORMSOFT_LIMITS_REFRESH_CRON=*/10 * * * *
# PROMETHEUS_URL=http://prometheus:9090

# Urgent trend alerts only; no daily digest.
# Defaults target about 0-2 Telegram alerts per week on the current signal volume.
# ADMIN_TREND_ALERT_CRON=25 * * * *
# TREND_ALERTS_ENABLED=true
# TREND_ALERT_WINDOW_HOURS=48
# TREND_ALERT_MIN_SIGNAL_SCORE=0.80
# TREND_ALERT_CHANGE_POINT_MIN_SIGNAL_SCORE=0.74
# TREND_ALERT_MIN_CHANGE_POINT_STRENGTH=0.70
# TREND_ALERT_MIN_DOC_COUNT=5
# TREND_ALERT_MIN_SOURCE_COUNT=3
# TREND_ALERT_MAX_PER_RUN=2
# TREND_ALERT_MAX_PER_7D=2

# ── GigaChat Vision ───────────────────────────────────────────────────────────
# Текущий worker читает GIGACHAT_VISION_MODEL и GIGACHAT_TOKEN_BUDGET_VISION_PROMPT.
# PADDLEOCR_URL включает дополнительный OCR поверх GigaChat Vision.
# GIGACHAT_VISION_MODEL=GigaChat-2-Pro
# GIGACHAT_TOKEN_BUDGET_VISION_PROMPT=600

# ── S3 расширенные настройки ──────────────────────────────────────────────────
# S3_ADDRESSING_STYLE=path          # path (Cloud.ru) | virtual (AWS)
# AWS_SIGNATURE_VERSION=s3v4
# S3_CONNECT_TIMEOUT_SEC=30
# S3_READ_TIMEOUT_SEC=60
# S3_MAX_RETRY_ATTEMPTS=3

# ── OpenRouter (не используется текущим compose) ──────────────────────────────
# В старом проекте ключ шёл в кастомный fallback внутри gpt2giga-proxy.
# Здесь прокси — только gpt2giga (run_proxy.py); worker ходит в OPENAI_API_BASE → gpt2giga-proxy.
# Чтобы реально использовать OpenRouter, нужна отдельная доработка прокси или второй LLM-endpoint.
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Telegram accounts ─────────────────────────────────────────────────────────
TG_API_ID_0=your_telegram_api_id_here
TG_API_HASH_0=your_telegram_api_hash_here
TG_API_ID_1=
TG_API_HASH_1=

# Telethon → DC Telegram: только SOCKS5 или MTProxy. gpt2giga-proxy (GigaChat) — отдельный сервис, сюда НЕ писать.
# Удобно одной строкой (host:port:user:password):
# TG_SOCKS5=HOST:PORT:USER:PASS
# Алиас той же строки: TG_PROXY_DSN=...
# Или по полям:
# TG_PROXY_HOST=
# TG_PROXY_PORT=1080
# TG_PROXY_USER=
# TG_PROXY_PASS=
# Как в docs/README.md (WireGuard): WG_SOCKS_HOST / WG_SOCKS_PORT (+ USER/PASS при необходимости)
# MTProxy (приоритет над SOCKS5, если заданы host+secret):
# MTPROXY_HOST=
# MTPROXY_PORT=443
# MTPROXY_SECRET=
# Xray/VLESS Reality -> локальный SOCKS5 sidecar для ingest.
# Best practice: не уводить весь контейнер в TUN, а дать Telethon локальный socks proxy.
# При включении xray задай TG_PROXY_HOST=xray и TG_PROXY_PORT=10808, а MTPROXY_* / TG_SOCKS5 очисти.
# XRAY_VLESS_ADDRESS=your_vless_server_here
# XRAY_VLESS_PORT=443
# XRAY_VLESS_ID=your_vless_uuid_here
# XRAY_VLESS_FLOW=xtls-rprx-vision
# XRAY_REALITY_SNI=your_reality_sni_here
# XRAY_REALITY_FP=chrome
# XRAY_REALITY_PBK=your_reality_public_key_here
# XRAY_REALITY_SID=your_reality_short_id_here
# XRAY_SOCKS_PORT=10808
# XRAY_LOG_LEVEL=warning
# Жёстко требовать прокси в environment (не учитывает только proxy_config в БД): 1 / true / on
# TG_REQUIRE_PROXY=1

# ── Worker (enrichment) ───────────────────────────────────────────────────────
# Параллельных обработчиков постов в одном батче (релевантность/embed → GigaChat). По умолчанию 4.
# INDEXING_MAX_CONCURRENCY=1
# Если у тарифа/flow только один одновременный запрос к GigaChat, лучше держать и worker, и сам клиент в single-flight режиме:
# GIGACHAT_MAX_SIMULTANEOUS_REQUESTS=1
# GIGACHAT_MIN_REQUEST_INTERVAL_MS=250

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=your_grafana_password_here
LOG_LEVEL=INFO

# ── SearXNG ───────────────────────────────────────────────────────────────────
# searxng/settings.yml is server-local because it contains server.secret_key.
# Template: searxng/settings.example.yml
# Generate/rotate on the server:
#   bash scripts/server-ensure-searxng-secret.sh
SEARXNG_URL=http://searxng:8080
SEARXNG_ENABLED=true
SEARXNG_TIMEOUT_SECONDS=8
# The SEARXNG_* knobs are forwarded to `worker`, `admin` and `mcp`; the
# MISSING_SIGNALS_* ones only to `worker` and `admin`, because `mcp` does not run
# the gap analysis. Until 2026-08-03 neither set was forwarded anywhere: the block
# below was documented as operator knobs, but no container received a single
# MISSING_SIGNALS_* variable, so editing this file changed nothing — the values
# came from the defaults baked into the image and retuning actually required a
# rebuild. `mcp` kept the same defect for SEARXNG_* until later that day, and it
# was the worse half of it: SEARXNG_ENABLED=false stopped the external calls in
# worker and admin while search_frontier / search_balanced went on making them.
# If you add a knob here, add it to the `environment:` allow-list of every service
# that reads it.
# NB: no inline comments on the value lines below. Compose strips them, but
# `docker run --env-file` does not, and standalone ops scripts then choke on the
# trailing text (see ops_env_no_inline_comments).
#
# SEARXNG_MAX_RESULTS is the denominator of _external_signal_strength — the whole
# gap arithmetic below is calibrated at 5. Changing it moves both corridors.
# SEARXNG_MAX_RESULTS=5
# SEARXNG_CATEGORIES=general,news
# SEARXNG_CACHE_TTL=3600
#
# Gap-analysis thresholds. Both sides of the gap subtraction now live in [0, 1]
# (frontier_frequency was an unbounded corpus-wide sum until 2026-08-03).
# MIN_GAP_SCORE is the floor on external evidence: 2 results from distinct
# domains score ~0.363, a single domain ~0.303, so the meaningful corridor is
# (0.303, 0.363] — below it single-domain payloads pass and the filter degenerates
# into "SearXNG answered at all"; above it the minimum admissible payload
# (MIN_EXTERNAL_RESULTS=2) can never pass.
# PRESENCE_SATURATION is the corpus share at which a topic counts as fully
# covered; pass condition is frontier_frequency <= SATURATION * (strength - MIN_GAP).
# MISSING_SIGNALS_MIN_GAP_SCORE=0.33
# MISSING_SIGNALS_PRESENCE_SATURATION=0.30
# MISSING_SIGNALS_MIN_EXTERNAL_RESULTS=2
# MISSING_SIGNALS_MAX_EVIDENCE_URLS=5
# MISSING_SIGNALS_TOPIC_LIMIT=8
# MISSING_SIGNALS_TIME_RANGE=month
# MISSING_SIGNALS_LANGUAGE=auto
# MISSING_SIGNALS_ENABLED=true
#
# The document-coverage gate (_MIN_TOPIC_OVERLAP) is deliberately NOT an env knob:
# it is a structural constant of the measure, pinned between the 1/3 and 1/2 marks
# of rarity-weighted containment. Moving it only makes sense together with the
# weight formula in worker/services/missing_signals.py.
# MISSING_SIGNALS_WINDOW_DAYS exists in shared/config.py but is read by no code —
# it is not forwarded on purpose, so it cannot look like a working knob.

# ── own_stake: the second axis on a card (task B) ─────────────────────────────
# Cosine similarity between the query and a SEPARATE Qdrant collection holding the
# author's own corpus. It sits NEXT TO the relevance number, never inside it:
# own_stake does not enter `score` and does not affect sort order. With
# OWN_STAKE_ENABLED=true the result order must be byte-identical to false apart
# from the two added keys (own_stake, stake_quadrant). If the order moves, that is
# a bug, not a setting — the whole point is the observable "low relevance + high
# own_stake" quadrant, and it stops existing the moment the two numbers are mixed.
#
# Forwarded to `mcp` only — the search path is the one and only reader. `worker`,
# `admin` and `ingest` contain no call to own_stake_scores / upsert_own_corpus_chunk
# / own_corpus_size, so forwarding anything there would be noise that looks like a
# working knob. The two writers — scripts/init_storage.py (creates the collection)
# and scripts/index_own_corpus.py (fills it) — run from the host or the workstation
# and read this file directly, bypassing compose. That is exactly why the values
# below must stay parseable on their own:
# NB: no inline comments on the value lines below. Compose strips them, but
# `docker run --env-file` and plain pydantic Settings do not, and the trailing text
# then breaks the standalone ops scripts (see ops_env_no_inline_comments).
#
# The corpus collection carries no workspace_id, _build_payload_filter is never
# applied to it, and neither hybrid_search nor get_frontier_brief reads it.
# Renaming it silently decouples the indexer from the search: the search then finds
# an empty collection and returns own_stake=0 for every card without changing the
# ordering of anything, so nothing looks broken.
# QDRANT_OWN_CORPUS_COLLECTION=own_corpus
#
# Off by default. The corpus is small — content/ideas.md ~12 KB, content/inbox.md a
# few hundred bytes, content/published/ empty, i.e. 40-60 chunks — and on that base
# one lucky match reads as a high score. Until it grows, read own_stake as "there is
# / is not a measurement of my own here", not as a magnitude.
# OWN_STAKE_ENABLED=false
#
# How many nearest corpus chunks are aggregated per hit. Aggregation is max, not
# mean: the signal matters if the author has at least one measurement of his own on
# the topic, not if the topic is smeared thinly across the whole corpus.
# OWN_STAKE_TOP_K=3
#
# PLACEHOLDERS, not measurements — written down here as placeholders on purpose.
# These two split the grid into four quadrants (post / run_your_own /
# personal_blind_spot / noise) and cannot be derived from anything available today:
# with sparse vectors on, `score` out of hybrid_search is an RRF rank (a sum of
# 1/(k+rank)), not a cosine, and it is not comparable between queries — while
# own_stake IS a cosine in [0, 1]. The two live on different scales on purpose;
# do not add or compare them, only threshold them.
# Where today's numbers come from (see shared/config.py, same reasoning):
#   OWN_STAKE_HIGH=0.60 — roughly the ceiling of the background cosine between
#     unrelated Russian texts under EmbeddingsGigaR, i.e. "above this it is probably
#     not coincidence". A property of the embedder, not of this corpus.
#   RELEVANCE_HIGH=0.40 — the single live `score` value ever observed in the review
#     of the current output (0.41). That is one RRF data point, not a quality bar.
# Real values come from the feedback of task C: record_card_feedback stores
# relevance_at_pick / own_stake_at_pick exactly as they were shown on the card, and
# the gate is 60 chosen/passed pairs carrying BOTH numbers — about 12 weekly batches
# of five. list_card_feedback reports axes_filled_total for precisely this count;
# read that, not the per-page axes_filled, which only describes the rows returned.
# Do not tune these before the gate, and when you do, change shared/config.py and
# the `mcp` defaults in docker-compose.yml together — if the baked default and the
# compose default drift apart, `docker run --env-file` and `docker compose` put the
# same card in different quadrants.
# OWN_STAKE_HIGH=0.60
# RELEVANCE_HIGH=0.40

# ── Security ───────────────────────────────────────────────────────────────────
# Admin (8101) and MCP (8100) are bound to 0.0.0.0 for LAN access.
# Do not expose them directly to the internet without firewall/VPN/reverse-proxy auth.
# CORS: set to specific origin(s) if needed, e.g. ["http://192.168.31.100"]
ALLOWED_ORIGINS=["*"]
# Optional: override the Python base image for COPY-based services if Docker Hub
# is flaky on the server, e.g. point to an internal registry mirror.
PYTHON_BASE_IMAGE=python:3.11-slim
