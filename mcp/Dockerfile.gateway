ARG PYTHON_BASE_IMAGE=python:3.11-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ARG PIP_INDEX_URL=

# Верхняя граница у mcp — не перестраховка, а разбор аварии 06.08.2026.
# Ограничение было `>=1.0.0`, слой pip лежал в кэше месяцами, и первая же
# пересборка (ради prometheus-client) подтянула mcp 2.0.0. В нём `mcp.server.fastmcp`
# удалён — переименован в `mcp.server.mcpserver.MCPServer`, — и контейнер ушёл в
# рестарт-луп с ModuleNotFoundError. То есть открытая верхняя граница ждала своего
# часа месяцами и выстрелила в момент, никак с ней не связанный.
# Переход на v2 — отдельная работа с правкой кода, а не побочный эффект сборки.

RUN if [ -n "$PIP_INDEX_URL" ]; then \
      pip install --no-cache-dir -i "$PIP_INDEX_URL" \
        "httpx>=0.27.0" \
        "mcp[cli]>=1.0.0,<2.0.0" \
        "prometheus-client>=0.20.0"; \
    else \
      pip install --no-cache-dir \
        "httpx>=0.27.0" \
        "mcp[cli]>=1.0.0,<2.0.0" \
        "prometheus-client>=0.20.0"; \
    fi

COPY mcp/mcp_gateway.py /app/mcp/mcp_gateway.py

ENV PYTHONPATH=/app

EXPOSE 8102

CMD ["python", "mcp/mcp_gateway.py"]
